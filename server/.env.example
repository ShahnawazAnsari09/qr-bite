# ---------------------------------------------------------------------------
# QR-Bite backend configuration
# Copy this file to `.env` and fill in real values before running the server.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Public URL of the React client. QR codes encode <CLIENT_URL>/t/<tableCode>,
# so this must be an address that a customer's phone can actually reach.
# On a real restaurant Wi-Fi that means your machine's LAN IP, not localhost.
CLIENT_URL=http://localhost:5173

# Comma-separated list of origins allowed to call the API / open a socket.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/qrbite

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Secret used to sign staff and customer JWTs. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Staff dashboard session lifetime.
JWT_EXPIRES_IN=12h
# Lifetime of the scoped token a customer receives after placing an order.
CUSTOMER_TOKEN_EXPIRES_IN=24h

# 32+ character key used for AES-256-GCM encryption of customer name/phone
# at rest (Chapter 4.4 "Data Encryption"). Changing this makes previously
# stored customer records unreadable, so set it once, before seeding.
DATA_ENCRYPTION_KEY=change-me-to-a-32-plus-character-secret-key

# ---------------------------------------------------------------------------
# WhatsApp Business API
# WHATSAPP_PROVIDER: mock | meta | twilio
#   mock   - no network calls; messages are persisted and logged. Use this for
#            development and for the project demo if you do not have a real
#            WhatsApp Business account.
#   meta   - WhatsApp Cloud API (graph.facebook.com)
#   twilio - Twilio WhatsApp
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=mock

# Default country code prepended to 10-digit local numbers (91 = India).
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# --- Meta WhatsApp Cloud API ---
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v20.0
# Approved template names. Free-form text only reaches a customer inside the
# 24-hour customer-service window; outside it WhatsApp requires a template.
META_TEMPLATE_ORDER_CONFIRMATION=
META_TEMPLATE_PROMOTION=
META_TEMPLATE_LANGUAGE=en

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender is whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------------------
# Seed script defaults (npm run seed)
# ---------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_STAFF_USERNAME=staff01
SEED_STAFF_PASSWORD=Staff@123
SEED_RESTAURANT_NAME=QR-Bite Demo Restaurant
SEED_TABLE_COUNT=8
