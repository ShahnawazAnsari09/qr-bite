# ---------------------------------------------------------------------------
# QR-Bite client configuration (optional)
#
# By default the client calls its own origin: `/api` in production, and the
# Vite dev proxy in development. Set these only if you deploy the client and
# the API to different hosts.
# ---------------------------------------------------------------------------

# Base URL of the REST API, including the /api prefix.
# VITE_API_BASE=https://api.example.com/api

# Origin of the Socket.io server. Leave unset to use the page's own origin.
# VITE_SOCKET_URL=https://api.example.com
