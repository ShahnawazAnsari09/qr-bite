{
  "name": "qr-bite",
  "version": "1.0.0",
  "private": true,
  "description": "QR-Bite: QR Code Based Restaurant Order & Feedback Management System",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "refresh:qr": "npm run refresh:qr --workspace server",
    "test": "npm test --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
